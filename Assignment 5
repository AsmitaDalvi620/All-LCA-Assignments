#To check if a password is weak or strong
import re

password = input("Enter Password")

if(len(password)>=8 and
   re.search(r'[a-z]',password) and 
   re.search(r'[A-Z]',password) and 
   re.search(r'[0-9]',password) and 
   re.search(r'[^a-zA-Z0-9]',password)):

    print("Strong Password")
else:
    print("Weak Password")
