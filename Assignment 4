#Matrix Addition using numpy
import numpy as np
def add(x,y):
    return x+y
def sub(x,y):
    return x-y
def mul(x,y):
    return x*y
def div(x,y):
    return x/y
x = np.array([[1,2,3],[4,5,6]])
y = np.array([[7,8,9],[10,11,12]])
z = input(
    "Please select an operator:\n"
    "Addition:+\n"
    "Subtraction:-\n"
    "Multiplication:*\n"
    "Division:/\n")
if z == "+":
    print(add(x,y))
elif z == "-":
    print(sub(x,y))
elif z == "*":
    print(mul(x,y))
elif z == "/":
    print(div(x,y))
else:
    print("Invalid Operator")
